# SaarthiFlow Environment Configuration

# Server Port
PORT=3001

# NVIDIA AI API Configuration (OpenAI-compatible)
# Base URL: https://integrate.api.nvidia.com/v1
# Get your API key from NVIDIA Build: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
# Supported active models on NVIDIA Build:
# - nvidia/nemotron-3.5-bolt-e4b (Recommended: fast, 250ms, instruction-tuned)
# - nvidia/nemotron-3.5-lightning-30b-a3b (30B reasoning model)
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Gemini AI API Configuration (Legacy/Fallback)
GEMINI_API_KEY=YOUR_AIza_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Supabase PostgreSQL Configuration (Optional)
# If left blank, SaarthiFlow operates automatically with reliable local persistent JSON storage.
# To connect to your Supabase project, execute supabase/schema.sql in Supabase SQL editor, then supply:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Client URL (for CORS)
CLIENT_URL=https://saarthi-flow-two.vercel.app,http://localhost:5173

# Frontend Vite API Base URL (passed to frontend during build / dev)
VITE_API_URL=http://localhost:3001/api
